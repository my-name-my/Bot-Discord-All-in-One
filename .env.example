# ── Discord ──────────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=""
# Application ID (Developer Portal → General Information → Application ID)
CLIENT_ID=""
# Comma-separated user IDs with bot-owner level access (tier: owner)
OWNER_IDS=""

# ── Defaults ─────────────────────────────────────────────────────────────────
PREFIX="!"
DEFAULT_LANGUAGE="vi"

# ── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use JSON storage (data/db/*.json). Requires zero extra setup.
# DATABASE_URL=

# SQLite (requires optional dependency: better-sqlite3)
# DATABASE_URL=sqlite://./data/bot.db

# PostgreSQL (requires optional dependency: pg)
# DATABASE_URL=postgres://user:password@localhost:5432/discordbot

# MySQL / MariaDB (requires optional dependency: mysql2)
# DATABASE_URL=mysql://user:password@localhost:3306/discordbot

# ── Slash commands registration ──────────────────────────────────────────────
# Register slash commands globally on startup (takes up to 1h to propagate).
AUTO_REGISTER_COMMANDS=true
# Optional: also register instantly to a single test guild while developing.
DEV_GUILD_ID=""

# ── Optional: minimal status dashboard ───────────────────────────────────────
DASHBOARD_ENABLED=false
DASHBOARD_PORT=3000

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL="info"

# ── Optional external services ───────────────────────────────────────────────
# Required only for Twitch live notifications (/notify add twitch ...)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
