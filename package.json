{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "All-in-one Discord bot: moderation, automod, logging, welcome, roles, tickets, levels, economy, giveaways, games, utility. Slash + prefix commands.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy-commands": "node scripts/deploy-commands.js",
    "check": "node scripts/check-syntax.js",
    "load-test": "node scripts/load-test.js",
    "test": "node scripts/smoke-test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "discord",
