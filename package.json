    "moderation",
    "automod",
    "economy",
    "tickets"
  ],
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.53",
    "better-sqlite3": "^11.10.0",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0"
  }
}
